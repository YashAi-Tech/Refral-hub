{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ],
  "env": {
    "GEMINI_API_KEY": "@gemini_api_key",
    "APP_URL": "@app_url"
  },
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}

